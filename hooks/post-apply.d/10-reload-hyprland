#!/usr/bin/env bash
set -euo pipefail
meta="${AUSPEX_GEN_DIR:-${AUSPEX_STATE:-$HOME/.local/state/auspex}/generations/$(printf %04d "$1")}/meta.json"
jq -e --arg p .config/hypr/ 'any(.targets[]; .path | startswith($p))' "$meta" >/dev/null || exit 0
[[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] || exit 0
hyprctl reload
