#!/usr/bin/env bash
# Reload mako when generation $1 wrote a file under ~/.config/mako/ and
# mako runs.
set -euo pipefail
meta="${AUSPEX_GEN_DIR:-${AUSPEX_STATE:-$HOME/.local/state/auspex}/generations/$(printf %04d "$1")}/meta.json"
jq -e --arg p .config/mako/ 'any(.targets[]; .path | startswith($p))' "$meta" >/dev/null || exit 0
pgrep -x mako >/dev/null || exit 0
makoctl reload
