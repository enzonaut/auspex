#!/usr/bin/env bash
set -euo pipefail
meta="${AUSPEX_GEN_DIR:-${AUSPEX_STATE:-$HOME/.local/state/auspex}/generations/$(printf %04d "$1")}/meta.json"
jq -e 'any(.targets[]; .path == ".config/hypr/hyprpaper.conf"
    or (.path | startswith(".local/share/auspex/wallpaper/")))' "$meta" >/dev/null || exit 0
pidof hyprpaper >/dev/null || exit 0
repo="${AUSPEX:-$(dirname "$(readlink -f "$0")")/../..}"
theme="$(head -n 1 -- "$repo/themes/current")"
hyprctl hyprpaper reload ",$HOME/.local/share/auspex/wallpaper/$theme.png"
