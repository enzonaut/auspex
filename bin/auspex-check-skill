#!/usr/bin/env bash
# auspex:summary=Check that the auspex skill matches the repo, or regenerate its generated files
# auspex:args=[--fix | --print-targets]
# auspex:level=1
# auspex:requires-sudo=false
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=../lib/common.sh
source "${AUSPEX:-$(dirname "$(readlink -f "$0")")/..}/lib/common.sh"

SKILL="$AUSPEX/agent/skills/auspex"
MAX_LINES=150
ERRORS=0

usage() {
    printf 'usage: auspex check skill [--fix | --print-targets]\n' >&2
    exit 2
}

fail() {
    printf '%s\n' "$*"
    ERRORS=$((ERRORS + 1))
}

print_commands() {
    printf '# Commands\n\n'
    # shellcheck disable=SC2016 # The backticks are Markdown, not a command.
    printf 'Generated by `auspex check skill --fix` from the command headers. Do not edit.\n\n'
    "$AUSPEX_BIN/auspex-commands" --markdown
}

print_targets() {
    local src tgt mode session
    printf '# Targets\n\n'
    # shellcheck disable=SC2016 # The backticks are Markdown, not a command.
    printf 'Generated by `auspex check skill --fix` from `manifest/user.tsv`. Do not edit.\n'
    printf 'Change the source in the repo, never the target.\n\n'
    printf '| Target | Source | Mode | Session |\n'
    printf '|---|---|---|---|\n'
    [[ -f "$AUSPEX_MANIFEST" ]] || auspex_die "no manifest at $AUSPEX_MANIFEST"
    while IFS=$'\t' read -r src tgt mode session || [[ -n "${src:-}" ]]; do
        [[ -z "${src:-}" || "$src" == '#'* ]] && continue
        # shellcheck disable=SC2016 # The backticks are Markdown, not a command.
        printf '| `%s` | `%s` | %s | %s |\n' "$tgt" "$src" "$mode" "${session:-any}"
    done <"$AUSPEX_MANIFEST"
}

top_folders() {
    if git -C "$AUSPEX" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        git -C "$AUSPEX" ls-files | sed -n 's|^\([^/.][^/]*\)/.*|\1|p' | LC_ALL=C sort -u
    else
        find "$AUSPEX" -mindepth 1 -maxdepth 1 -type d ! -name '.*' -printf '%f\n' | LC_ALL=C sort
    fi
}

backticked() {
    # shellcheck disable=SC2016 # The backticks are Markdown, not a command.
    grep -v '^[[:space:]]*```' -- "$1" | grep -o '`[^`]*`' | sed 's/^`//; s/`$//' || true
}

check_generated() {
    local name="$1" want="$2"
    if [[ ! -f "$SKILL/reference/$name" ]]; then
        fail "reference/$name: missing; run auspex check skill --fix"
    elif ! cmp -s "$want" "$SKILL/reference/$name"; then
        fail "reference/$name: out of date; run auspex check skill --fix"
    fi
}

check_layout() {
    local layout="$SKILL/reference/layout.md" d
    local -A named=() tops=()
    if [[ ! -f "$layout" ]]; then
        fail "reference/layout.md: missing"
        return
    fi
    while IFS= read -r d; do
        [[ "$d" =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]*/$ ]] && named[${d%/}]=1
    done < <(backticked "$layout")
    while IFS= read -r d; do
        tops[$d]=1
        [[ -n "${named[$d]:-}" ]] || fail "reference/layout.md: does not name the folder $d/"
    done < <(top_folders)
    for d in "${!named[@]}"; do
        [[ -n "${tops[$d]:-}" ]] || fail "reference/layout.md: names $d/, which is not a top-level repo folder"
    done
}

routes() {
    local name=auspex w
    (($# > 0)) || return 0
    case "$1" in help | --help | -h) return 0 ;; esac
    for w in "$@"; do
        [[ "$w" =~ ^[a-z0-9][a-z0-9-]*$ ]] || break
        name+="-$w"
        [[ -x "$AUSPEX_BIN/$name" ]] && return 0
    done
    return 1
}

check_spans() {
    local f rel span top
    local -a words
    local -A tops=()
    while IFS= read -r top; do
        tops[$top]=1
    done < <(top_folders)
    while IFS= read -r f; do
        rel="${f#"$SKILL/"}"
        while IFS= read -r span; do
            if [[ "$span" == 'auspex '* ]]; then
                read -r -a words <<<"${span#auspex }"
                routes "${words[@]}" || fail "$rel: \`$span\` does not route to a command"
                continue
            fi
            [[ "$span" =~ ^[A-Za-z0-9_.-]+(/[^[:space:]]*)?$ ]] || continue
            [[ "$span" != *[\<\>\*\{\}\$]* ]] || continue
            top="${span%%/*}"
            [[ -n "${tops[$top]:-}" ]] || continue
            [[ -e "$AUSPEX/${span%/}" ]] || fail "$rel: \`$span\` does not exist in the repo"
        done < <(backticked "$f")
    done < <(find "$SKILL" -type f -name '*.md' | LC_ALL=C sort)
}

check_skill_md() {
    local f="$SKILL/SKILL.md" lines front
    if [[ ! -f "$f" ]]; then
        fail "SKILL.md: missing"
        return
    fi
    lines="$(wc -l <"$f")"
    ((lines <= MAX_LINES)) || fail "SKILL.md: $lines lines; the limit is $MAX_LINES"
    if [[ "$(head -n 1 "$f")" != '---' ]]; then
        fail "SKILL.md: no front matter"
        return
    fi
    front="$(sed -n '2,/^---$/p' "$f")"
    grep -q '^name: *[^ ]' <<<"$front" || fail "SKILL.md: front matter lacks name"
    grep -q '^description: *[^ ]' <<<"$front" || fail "SKILL.md: front matter lacks description"
}

fix() {
    mkdir -p -- "$SKILL/reference"
    if ! cmp -s "$1" "$SKILL/reference/commands.md"; then
        cp -- "$1" "$SKILL/reference/commands.md"
        printf 'wrote reference/commands.md\n'
    fi
    if ! cmp -s "$2" "$SKILL/reference/targets.md"; then
        cp -- "$2" "$SKILL/reference/targets.md"
        printf 'wrote reference/targets.md\n'
    fi
}

mode="${1:-}"
case "$mode" in
    "" | --fix) ;;
    --print-targets)
        print_targets
        exit 0
        ;;
    *) usage ;;
esac
(($# <= 1)) || usage

[[ -d "$SKILL" ]] || auspex_die "no skill folder at $SKILL"
auspex_work_init
print_commands >"$AUSPEX_WORK/commands.md"
print_targets >"$AUSPEX_WORK/targets.md"
[[ "$mode" != --fix ]] || fix "$AUSPEX_WORK/commands.md" "$AUSPEX_WORK/targets.md"

check_generated commands.md "$AUSPEX_WORK/commands.md"
check_generated targets.md "$AUSPEX_WORK/targets.md"
check_layout
check_spans
check_skill_md

if ((ERRORS > 0)); then
    printf 'auspex check skill: %d error(s)\n' "$ERRORS"
    exit 1
fi
printf 'auspex check skill: ok\n'
