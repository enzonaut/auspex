#!/usr/bin/env bash
# Router: auspex <words...> runs the longest existing bin/auspex-<w1>-<w2>-...
# and passes the rest of the words as arguments.
set -euo pipefail

if [[ -z "${AUSPEX:-}" ]]; then
    AUSPEX="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd -P)"
fi
export AUSPEX

if [[ $# -eq 0 || "$1" == help || "$1" == --help || "$1" == -h ]]; then
    exec "$AUSPEX/bin/auspex-commands"
fi

# Only words of [a-z0-9] can form a command name. This keeps "../" and
# other path parts out of the lookup.
max=0
for word in "$@"; do
    [[ "$word" =~ ^[a-z0-9]+$ ]] || break
    max=$((max + 1))
done

words=("$@")
for ((n = max; n >= 1; n--)); do
    name="auspex"
    for ((i = 0; i < n; i++)); do
        name+="-${words[i]}"
    done
    if [[ -f "$AUSPEX/bin/$name" && -x "$AUSPEX/bin/$name" ]]; then
        exec "$AUSPEX/bin/$name" "${words[@]:n}"
    fi
done

printf 'auspex: error: unknown command: %s\n' "$*" >&2
printf "Run 'auspex help' for the command list.\n" >&2
exit 2
