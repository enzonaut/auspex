#!/usr/bin/env bash
# auspex:summary=Show or hide the agent dropdown console (Hyprland: special:agent, KDE: ghostty quick terminal)
# auspex:args=[--dry-run]
# auspex:level=3
# auspex:requires-sudo=false
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=../lib/common.sh
source "${AUSPEX:-$(dirname "$(readlink -f "$0")")/..}/lib/common.sh"

dry=0
case "${1:-}" in
    "") ;;
    --dry-run) dry=1 ;;
    *) auspex_die "usage: auspex agent dropdown [--dry-run]" ;;
esac

NAME=auspex.dropdown

add_path() {
    case ":$PATH:" in
        *":$HOME/.local/bin:"*) ;;
        *) PATH="$PATH:$HOME/.local/bin" ;;
    esac
    command -v auspex >/dev/null 2>&1 || PATH="$PATH:$AUSPEX/bin"
    export PATH
}

if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    start=(ghostty "--class=$NAME" --gtk-single-instance=false -e auspex agent --here)
    toggle=(hyprctl dispatch 'hl.dsp.workspace.toggle_special("agent")')
    if [[ "$dry" -eq 1 ]]; then
        printf 'start (when no window has class %s, from %s):' "$NAME" "$HOME"
        printf ' %q' "${start[@]}"
        printf '\ntoggle:'
        printf ' %q' "${toggle[@]}"
        printf '\n'
        exit 0
    fi
    has_window() {
        hyprctl -j clients 2>/dev/null | jq -e --arg c "$NAME" 'any(.[]; .class == $c)' >/dev/null
    }
    add_path
    if ! has_window; then
        (cd "$HOME" && setsid "${start[@]}" >/dev/null 2>&1 </dev/null &)
        for _ in $(seq 50); do
            has_window && break
            sleep 0.1
        done
        has_window || auspex_die "no window with class $NAME after 5 s"
    fi
    out="$("${toggle[@]}" 2>&1)" || true
    [[ "$out" == ok* ]] || hyprctl dispatch togglespecialworkspace agent >/dev/null
    exit 0
fi
if [[ ":${XDG_CURRENT_DESKTOP:-}:" != *:KDE:* ]]; then
    printf 'skip: not a KDE or Hyprland session\n'
    exit 0
fi

start=(ghostty --config-default-files=false
    "--config-file=$AUSPEX/config/ghostty/auspex-dropdown.ghostty"
    "--class=$NAME" --gtk-single-instance=true)
toggle=(gdbus call --session --dest "$NAME" --object-path /auspex/dropdown
    --method org.gtk.Actions.Activate toggle-quick-terminal '[]' '{}')

if [[ "$dry" -eq 1 ]]; then
    printf 'start (when %s is not on the bus, from %s):' "$NAME" "$HOME"
    printf ' %q' "${start[@]}"
    printf '\ntoggle:'
    printf ' %q' "${toggle[@]}"
    printf '\n'
    exit 0
fi

has_name() {
    gdbus call --session --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus \
        --method org.freedesktop.DBus.NameHasOwner "$NAME" 2>/dev/null | grep -q true
}

add_path

if ! has_name; then
    (cd "$HOME" && setsid "${start[@]}" >/dev/null 2>&1 </dev/null &)
    for _ in $(seq 50); do
        has_name && break
        sleep 0.1
    done
    has_name || auspex_die "ghostty did not take the bus name $NAME in 5 s"
fi
"${toggle[@]}" >/dev/null
