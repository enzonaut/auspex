#!/usr/bin/env bash
# auspex:summary=Check each system step (functions, headers, declared reads, syntax, KDE deny list) and run the runner tests
# auspex:args=[--static]
# auspex:level=1
# auspex:requires-sudo=false
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=../lib/common.sh
source "${AUSPEX:-$(dirname "$(readlink -f "$0")")/..}/lib/common.sh"
# shellcheck source-path=SCRIPTDIR source=../lib/system-steps.sh
source "$AUSPEX/lib/system-steps.sh"

static_only=0
case "${1:-}" in
    --static) static_only=1 ;;
    '') ;;
    *) auspex_die "usage: auspex check system-steps [--static]" 2 ;;
esac

deny_re='(\.config/plasma|\.config/k|~/\.config/k|/etc/sddm\.conf\.d|/usr/share/sddm|/usr/share/plasma)'
sddm_allow_step=060-avgvr-sddm
sddm_allow_sed='s#(/etc/sddm\.conf\.d/zz-auspex-avgvr\.conf|/usr/share/sddm/themes/avgvr(\.new)?)([^A-Za-z0-9_./-]|$)#\3#g'
repo_path_re='(^|[^A-Za-z0-9_.-])(packages|system/files|config)/[^[:space:]"'"'"';)}]*'

fail=0
n=0
while IFS= read -r step; do
    [[ -n "$step" ]] || continue
    n=$((n + 1))
    file="$(system_step_file "$step")"
    errs=()
    for fn in check apply undo; do
        grep -Eq "^${fn}\(\) *\{" "$file" || errs+=("no $fn function")
    done
    [[ "$(auspex_header "$file" level || true)" == 3 ]] || errs+=("header level is not 3")
    [[ "$(auspex_header "$file" requires-sudo || true)" == true ]] || errs+=("header requires-sudo is not true")
    [[ -n "$(auspex_header "$file" summary || true)" ]] || errs+=("no summary header")
    bash -n "$file" 2>/dev/null || errs+=("bash -n fails")
    if [[ "$step" == "$sddm_allow_step" ]]; then
        hits="$(sed -E "$sddm_allow_sed" "$file" | grep -nE "$deny_re")" || hits=""
    else
        hits="$(grep -nE "$deny_re" "$file")" || hits=""
    fi
    if [[ -n "$hits" ]]; then
        errs+=("names a KDE deny-list path: ${hits//$'\n'/; }")
    fi
    text=""
    if system_step_read "$file"; then
        text="$REPLY"
    else
        errs+=("cannot read the step (a symlink, a NUL byte or over $SYSTEM_STEP_MAX_BYTES bytes)")
    fi
    declared=()
    if reads="$(system_step_reads "$step" "$text" 2>&1)"; then
        while IFS= read -r p; do
            [[ -n "$p" ]] || continue
            declared+=("$p")
            [[ -f "$AUSPEX/$p" && ! -L "$AUSPEX/$p" ]] || errs+=("the reads file $p is missing or not a regular file")
        done <<<"$reads"
    else
        errs+=("${reads#auspex: error: }")
    fi
    while IFS= read -r p; do
        [[ -n "$p" ]] || continue
        [[ " ${declared[*]} " == *" $p "* ]] && continue
        covered=0
        for d in "${declared[@]}"; do
            [[ "$d" == */SHA256SUMS && -f "$AUSPEX/$d" ]] || continue
            top="${d%/SHA256SUMS}"
            while read -r _ f; do
                [[ "$top/$f" == "$p" || "$top/$f" == "${p%/}"/* ]] && covered=1
            done <"$AUSPEX/$d"
        done
        ((covered)) || errs+=("reads $p but does not declare it in auspex:reads or in a declared SHA256SUMS dir")
    done < <(grep -v '^# auspex:reads=' <<<"$text" | grep -oE "$repo_path_re" | sed -E 's|^[^A-Za-z0-9_.-]||' | LC_ALL=C sort -u)
    if [[ ${#errs[@]} -eq 0 ]]; then
        printf 'ok %s\n' "$step"
    else
        fail=1
        for e in "${errs[@]}"; do
            printf 'FAIL %s: %s\n' "$step" "$e"
        done
    fi
done < <(system_step_list)

[[ $n -gt 0 ]] || { printf 'no system steps found\n'; exit 77; }
[[ $fail -eq 0 ]] || exit 1
((static_only)) && exit 0

if ! command -v bats >/dev/null 2>&1; then
    printf 'bats is missing; run step 030-auspex-tools\n'
    exit 77
fi
exec bats "$AUSPEX/tests/system-steps.bats"
