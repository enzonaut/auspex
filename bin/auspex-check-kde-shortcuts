#!/usr/bin/env bash
# auspex:summary=Test the KDE shortcut merger, its reload hooks and the live file for key conflicts
# auspex:args=none
# auspex:level=1
# auspex:requires-sudo=false
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=../lib/common.sh
source "${AUSPEX:-$(dirname "$(readlink -f "$0")")/..}/lib/common.sh"

"$AUSPEX/bin/auspex" check keys
if ! command -v bats >/dev/null 2>&1; then
    printf 'bats is missing; run step 030-auspex-tools\n'
    exit 77
fi
exec bats "$AUSPEX/tests/kde-shortcuts.bats"
