{
  "id": "root",
  "type": "column",
  "titlebar": "none",
  "background": "canvas",
  "terminal_padding": [14, 12],
  "divider": { "width": 1, "color": "border" },
  "children": [
    {
      "id": "spaces",
      "type": "block",
      "size": { "px": 30 },
      "radius": 0,
      "window_drag": true,
      "content": { "mod": "avgvr-spaces" }
    },
    {
      "id": "tabs",
      "type": "block",
      "size": { "px": 42 },
      "radius": 0,
      "window_drag": true,
      "content": { "mod": "tabs" }
    },
    {
      "id": "work-body",
      "type": "row",
      "padding": 8,
      "gap": 8,
      "radius": 0,
      "children": [
        {
          "id": "main",
          "type": "block",
          "radius": 0,
          "content": {
            "tab": "active",
            "pane": {
              "gap": 8,
              "radius": 0,
              "background": "background",
              "lone": true,
              "border": { "width": 1, "color": "border" },
              "focus": { "width": 1, "color": "#C9A05A" },
              "header": {
                "content": { "mod": "pane" },
                "height": 30,
                "position": "top",
                "reveal": "always"
              }
            }
          }
        },
        {
          "id": "panel",
          "type": "column",
          "hidden": true,
          "size": { "px": 368 },
          "min": 280,
          "max": 900,
          "radius": 0,
          "children": [
            {
              "id": "panel-body",
              "type": "stack",
              "active": "files",
              "children": [
                { "id": "files", "type": "block", "radius": 0, "content": { "mod": "files" } },
                { "id": "changes", "type": "block", "radius": 0, "content": { "mod": "changes" } }
              ]
            }
          ]
        }
      ]
    }
  ]
}
