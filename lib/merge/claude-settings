#!/usr/bin/env bash
set -euo pipefail

die() {
    printf 'claude-settings: %s\n' "$*" >&2
    exit 1
}

SETTINGS='length == 1 and (.[0] | type == "object"
    and ((.permissions // {}) | type == "object")
    and ((.permissions.deny // []) | type == "array" and all(type == "string")))'
SOURCE='length == 1 and (.[0] | type == "object" and keys == ["permissions"]
    and (.permissions | type == "object" and keys == ["deny"])
    and (.permissions.deny | type == "array" and length > 0
        and all(type == "string" and length > 0)))'
OWNED='length == 1 and (.[0] | type == "array" and all(type == "string"))'

args=()

load() {
    if [[ -e "$2" ]]; then
        jq -s -e "$3" "$2" >/dev/null 2>&1 || die "$2 is not valid"
        args+=(--slurpfile "$1" "$2")
    else
        args+=(--argjson "$1" "[$4]")
    fi
}

tmp="$(mktemp)"
trap 'rm -f -- "$tmp"' EXIT

case "${1:-}" in
    merge)
        [[ $# -eq 6 ]] || die "usage: merge <source> <target> <owned-in> <out> <owned-out>"
        [[ -f "$2" ]] || die "no source $2"
        load src "$2" "$SOURCE" null
        load cur "$3" "$SETTINGS" '{}'
        load own "$4" "$OWNED" '[]'
        jq -n "${args[@]}" '
            $src[0].permissions.deny as $s
            | $cur[0] as $t
            | ($t.permissions.deny // []) as $c
            | $own[0] as $o
            | ($c - ($o - $s)) as $base
            | (reduce $s[] as $r ($base; if any(.[]; . == $r) then . else . + [$r] end)) as $new
            | {
                changed: ($new != $c),
                settings: ($t | .permissions.deny = $new),
                owned: ((($o - ($o - $s)) + ($s - $c)) | unique)
            }' >"$tmp"
        if [[ -e "$3" && "$(jq '.changed' "$tmp")" == false ]]; then
            cp -- "$3" "$5"
        else
            jq --indent 2 '.settings' "$tmp" >"$5"
        fi
        jq '.owned' "$tmp" >"$6"
        ;;
    restore)
        [[ $# -eq 6 ]] || die "usage: restore <before> <target> <owned-now> <owned-before> <out>"
        if [[ ! -e "$3" ]]; then
            if [[ -e "$2" ]]; then cp -- "$2" "$6"; else : >"$6"; fi
            exit 0
        fi
        load bef "$2" "$SETTINGS" null
        load tgt "$3" "$SETTINGS" null
        load now "$4" "$OWNED" '[]'
        load ob "$5" "$OWNED" '[]'
        jq -n "${args[@]}" '
            $bef[0] as $b | $tgt[0] as $t
            | ($b.permissions.deny // []) as $bd
            | (($t.permissions.deny // []) - $now[0]) as $keep
            | ($keep + $ob[0]) as $want
            | ([$bd[] | select(IN($want[]))]
                + [$keep[] | select(IN($bd[]) | not)]
                + [($ob[0] - $keep)[] | select(IN($bd[]) | not)]) as $deny
            | ($t | .permissions.deny = $deny
                | if $deny == [] and $b.permissions.deny == null then del(.permissions.deny) else . end
                | if .permissions == {} and $b.permissions == null then del(.permissions) else . end) as $r
            | {same: ($b != null and $r == $b), empty: ($b == null and $r == {}), settings: $r}' >"$tmp"
        if [[ "$(jq '.same' "$tmp")" == true ]]; then
            cp -- "$2" "$6"
        elif [[ "$(jq '.empty' "$tmp")" == true ]]; then
            : >"$6"
        else
            jq --indent 2 '.settings' "$tmp" >"$6"
        fi
        ;;
    digest)
        [[ $# -eq 3 ]] || die "usage: digest <target> <owned>"
        [[ -e "$2" && -e "$3" ]] || exit 0
        load tgt "$2" "$SETTINGS" null
        load own "$3" "$OWNED" '[]'
        jq -n -r "${args[@]}" '($own[0] - ($own[0] - ($tgt[0].permissions.deny // []))) | unique | .[]'
        ;;
    *)
        printf 'usage: claude-settings merge|restore|digest ...\n' >&2
        exit 2
        ;;
esac
