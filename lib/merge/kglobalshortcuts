#!/usr/bin/env bash
set -euo pipefail

ABSENT='__auspex_absent__'
KGA=(--session --dest org.kde.kglobalaccel --object-path /kglobalaccel)

die() {
    printf 'kglobalshortcuts: %s\n' "$*" >&2
    exit 1
}

note() {
    printf 'kglobalshortcuts: %s\n' "$*"
}

declare -a SRC_GROUPS=()
declare -A SRC_VALUE=()
parse_source() {
    local line group="" n=0
    [[ -f "$1" ]] || die "no source $1"
    while IFS= read -r line || [[ -n "$line" ]]; do
        n=$((n + 1))
        [[ -z "$line" || "$line" == '#'* ]] && continue
        if [[ "$line" =~ ^\[services\]\[([A-Za-z0-9._-]+\.desktop)\]$ ]]; then
            group="${BASH_REMATCH[1]}"
            [[ -z "${SRC_VALUE[$group]+x}" ]] || die "$1 line $n: group $group is on 2 lines"
            SRC_VALUE[$group]=""
            SRC_GROUPS+=("$group")
        elif [[ "$line" =~ ^_launch=([A-Za-z0-9+\`]+)$ ]]; then
            [[ -n "$group" && -z "${SRC_VALUE[$group]}" ]] || die "$1 line $n: _launch outside a group or set 2 times"
            SRC_VALUE[$group]="${BASH_REMATCH[1]}"
        else
            die "$1 line $n: only [services][<file>.desktop] groups with a _launch key are allowed"
        fi
    done <"$1"
    [[ ${#SRC_GROUPS[@]} -gt 0 ]] || die "$1 has no group"
    for group in "${SRC_GROUPS[@]}"; do
        [[ -n "${SRC_VALUE[$group]}" ]] || die "$1: group $group has no _launch key"
    done
}

check_owned() {
    [[ -e "$1" ]] || return 0
    jq -e 'type == "object"
        and all(keys[]; test("^[A-Za-z0-9._-]+\\.desktop$"))
        and all(.[]; type == "object" and has("earlier")
            and (.earlier == null or (.earlier | type == "string")))' "$1" >/dev/null 2>&1 ||
        die "$1 is not valid"
}

owned_groups() {
    [[ -e "$1" ]] || return 0
    jq -r 'keys[]' "$1"
}

owned_earlier() {
    jq -r --arg g "$2" --arg a "$ABSENT" '.[$g].earlier // $a' "$1"
}

abs() {
    realpath -m -- "$1"
}

read_key() {
    if [[ ! -s "$1" ]]; then
        printf '%s\n' "$ABSENT"
        return 0
    fi
    kreadconfig6 --file "$(abs "$1")" --group services --group "$2" --key _launch --default "$ABSENT"
}

set_key() {
    local now
    now="$(read_key "$1" "$2")"
    [[ "$now" != "$3" ]] || return 0
    if [[ "$3" == "$ABSENT" ]]; then
        kwriteconfig6 --file "$(abs "$1")" --group services --group "$2" --key _launch --delete
    else
        kwriteconfig6 --file "$(abs "$1")" --group services --group "$2" --key _launch -- "$3"
    fi
}

copy_or_empty() {
    if [[ -e "$1" ]]; then cp -- "$1" "$2"; else : >"$2"; fi
}

cmd_merge() {
    local src="$1" tgt="$2" own="$3" out="$4" oout="$5" g earlier
    local -A owned=()
    parse_source "$src"
    check_owned "$own"
    copy_or_empty "$tgt" "$out"
    while IFS= read -r g; do
        [[ -n "$g" ]] || continue
        owned[$g]="$(owned_earlier "$own" "$g")"
        if [[ -z "${SRC_VALUE[$g]+x}" ]]; then
            set_key "$out" "$g" "${owned[$g]}"
        fi
    done < <(owned_groups "$own")
    printf '{}' >"$oout.tmp"
    for g in "${SRC_GROUPS[@]}"; do
        if [[ -n "${owned[$g]+x}" ]]; then
            earlier="${owned[$g]}"
        else
            earlier="$(read_key "$out" "$g")"
        fi
        jq --arg g "$g" --arg e "$earlier" --arg a "$ABSENT" \
            '.[$g] = {earlier: (if $e == $a then null else $e end)}' "$oout.tmp" >"$oout.tmp2"
        mv -f -- "$oout.tmp2" "$oout.tmp"
        set_key "$out" "$g" "${SRC_VALUE[$g]}"
    done
    jq -S . "$oout.tmp" >"$oout"
    rm -f -- "$oout.tmp"
}

cmd_restore() {
    local bef="$1" tgt="$2" now="$3" ob="$4" out="$5" g v
    check_owned "$now"
    check_owned "$ob"
    if [[ ! -e "$tgt" ]]; then
        copy_or_empty "$bef" "$out"
        return 0
    fi
    cp -- "$tgt" "$out"
    while IFS= read -r g; do
        [[ -n "$g" ]] || continue
        if [[ -e "$bef" ]]; then v="$(read_key "$bef" "$g")"; else v="$ABSENT"; fi
        set_key "$out" "$g" "$v"
    done < <({ owned_groups "$now"; owned_groups "$ob"; } | LC_ALL=C sort -u)
}

cmd_digest() {
    local tgt="$1" own="$2" g v
    [[ -e "$tgt" && -e "$own" ]] || return 0
    check_owned "$own"
    while IFS= read -r g; do
        [[ -n "$g" ]] || continue
        v="$(read_key "$tgt" "$g")"
        [[ "$v" != "$ABSENT" ]] || v="<absent>"
        printf '%s=%s\n' "$g" "$v"
    done < <(owned_groups "$own" | LC_ALL=C sort)
}

qt_code() {
    local -a parts
    local part code=0 key
    IFS=+ read -r -a parts <<<"$1"
    [[ "$1" != *+ && ${#parts[@]} -ge 1 ]] || return 1
    for part in "${parts[@]::${#parts[@]}-1}"; do
        case "$part" in
            Meta) code=$((code | 0x10000000)) ;;
            Ctrl) code=$((code | 0x04000000)) ;;
            Alt) code=$((code | 0x08000000)) ;;
            Shift) code=$((code | 0x02000000)) ;;
            *) return 1 ;;
        esac
    done
    key="${parts[-1]}"
    case "$key" in
        [A-Z0-9]) printf -v key '%d' "'$key"; code=$((code | key)) ;;
        '`') code=$((code | 0x60)) ;;
        F[1-9] | F[1-2][0-9] | F3[0-5]) code=$((code | (0x01000030 + ${key#F} - 1))) ;;
        *) return 1 ;;
    esac
    printf '%d\n' "$code"
}

kga_has_bus() {
    command -v gdbus >/dev/null 2>&1 || return 1
    gdbus call --session --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus \
        --method org.freedesktop.DBus.NameHasOwner org.kde.kglobalaccel 2>/dev/null | grep -q true
}

cmd_reload() {
    local src="$1" tgt="$2" own="$3" g v name id keys k c
    parse_source "$src"
    check_owned "$own"
    if ! kga_has_bus; then
        note "kglobalaccel is not on the session bus; no reload (not a KDE session)"
        return 0
    fi
    while IFS= read -r g; do
        [[ -n "$g" ]] || continue
        v="$(read_key "$tgt" "$g")"
        v="${v%%,*}"
        name="${g%.desktop}"
        name="${name//-/ }"
        id="['$g','_launch','$name','Launch $name']"
        if [[ "$v" == "$ABSENT" || "$v" == "" || "$v" == none ]]; then
            gdbus call "${KGA[@]}" --method org.kde.KGlobalAccel.setForeignShortcutKeys "$id" "@a(ai) []" >/dev/null
            gdbus call "${KGA[@]}" --method org.kde.KGlobalAccel.unregister "$g" _launch >/dev/null
            note "unloaded $g"
            continue
        fi
        keys=""
        while IFS= read -r k; do
            c="$(qt_code "$k")" || { keys="?"; break; }
            keys+="${keys:+, }([$c],)"
        done < <(printf '%s\n' "${v//$'\t'/$'\n'}")
        if [[ "$keys" == "?" ]]; then
            note "cannot load $g=$v live; log out and in once"
            continue
        fi
        gdbus call "${KGA[@]}" --method org.kde.KGlobalAccel.doRegister "$id" >/dev/null
        gdbus call "${KGA[@]}" --method org.kde.KGlobalAccel.setForeignShortcutKeys "$id" "[$keys]" >/dev/null
        note "loaded $g=$v"
    done < <({ printf '%s\n' "${SRC_GROUPS[@]}"; owned_groups "$own"; } | LC_ALL=C sort -u)
}

case "${1:-}" in
    merge)
        [[ $# -eq 6 ]] || die "usage: merge <source> <target> <owned-in> <out> <owned-out>"
        cmd_merge "${@:2}"
        ;;
    restore)
        [[ $# -eq 6 ]] || die "usage: restore <before> <target> <owned-now> <owned-before> <out>"
        cmd_restore "${@:2}"
        ;;
    digest)
        [[ $# -eq 3 ]] || die "usage: digest <target> <owned>"
        cmd_digest "${@:2}"
        ;;
    reload)
        [[ $# -eq 4 ]] || die "usage: reload <source> <target> <owned>"
        cmd_reload "${@:2}"
        ;;
    *)
        printf 'usage: kglobalshortcuts merge|restore|digest|reload ...\n' >&2
        exit 2
        ;;
esac
